{
  "name": "computescope-team-data",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": "24.x" },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "db:setup": "node --env-file-if-exists=.env scripts/setup-db.mjs",
