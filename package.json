    "capture:lium": "node scripts/capture-lium.mjs",
    "ingest:lium": "node --env-file-if-exists=.env scripts/ingest-lium.mjs",
    "ingest:workloads": "node --env-file-if-exists=.env scripts/ingest-workloads.mjs",
    "data:profile": "node --env-file-if-exists=.env scripts/profile-data.mjs"
